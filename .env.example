# ─────────────────────────────────────────────────────────────────────────────
# AdBrief — exemplo de variáveis. Copie para .env e preencha.
# NENHUM valor real entra neste arquivo. .env está no .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (VITE_*) ────────────────────────────────────────────────────────
# Só chaves publishable/anon. Elas vão para o bundle do site e são públicas por
# design — a proteção real é o RLS no banco, não o segredo da chave.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>


# ═════════════════════════════════════════════════════════════════════════════
# CREATIVE INTELLIGENCE
#
# Nada abaixo desta linha pode aparecer no frontend. São secrets de servidor:
# ficam nos Secrets do Lovable (edge functions) ou no `fly secrets set`
# (worker). Se uma delas precisar de prefixo VITE_ para funcionar, algo está
# arquitetado errado.
# ═════════════════════════════════════════════════════════════════════════════

# ── SpreshApp — Facebook Ad Library API ──────────────────────────────────────
# Onde pegar: https://spreshapp.com/app/api-access  (a chave começa com sk_sprs_)
# Docs: https://spreshapp.com/docs/api
#
# Créditos: 100 grátis por mês, add-on de 5.000 por US$ 3/mês. Reseta dia 1 e
# não acumula. Custo por chamada:
#   GET  /v1/brand/page-search      5 créditos por chamada
#   GET  /v1/brand/:page_id         1 crédito por anúncio retornado
#   POST /v1/ad-search              1 crédito por anúncio retornado
#   GET  /v1/ad-details/:id         1 crédito quando devolve dados, 0 quando não
SPRESHAPP_API_KEY=
SPRESHAPP_BASE_URL=https://api.spreshapp.com

# Tetos de segurança. O import é BLOQUEADO acima disto — não é aviso, é recusa.
# Existem porque 3.000 anúncios = ~3.005 créditos, e um clique errado gastaria
# a cota do mês inteiro.
SPRESHAPP_MAX_ADS_PER_RUN=20
SPRESHAPP_MAX_CREDITS_PER_RUN=50

# ── Storage ──────────────────────────────────────────────────────────────────
# 'supabase' usa o bucket ci-media com a service role — nenhuma credencial
# extra. 's3' usa as variáveis abaixo e funciona com Cloudflare R2 ou
# Backblaze B2 sem mudar código.
CI_STORAGE_BACKEND=supabase
CI_STORAGE_BUCKET=ci-media

# Só preencher se CI_STORAGE_BACKEND=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Worker (Fly.io) ──────────────────────────────────────────────────────────
# Definir com: fly secrets set -a adbrief-ci-worker CHAVE=valor
# A service role ignora RLS. Nunca sai do worker.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CI_WORKER_ID=fly-worker-1
CI_WORKER_CONCURRENCY=2
# Teto de disco temporário. O worker recusa novos jobs acima disto em vez de
# encher o volume e travar.
CI_TMP_MAX_MB=4096
CI_DOWNLOAD_TIMEOUT_S=180
CI_MAX_MEDIA_MB=500

# ── Análise multimodal ───────────────────────────────────────────────────────
# Gemini é o principal. Atenção: a chave vai no header x-goog-api-key —
# `Authorization: Bearer` devolve 401 com chaves no formato novo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback opcional. Sem nenhuma das duas, o pipeline roda em modo local e a
# análise é gravada com fidelity='degraded' — a UI mostra a diferença.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Diarização de falantes (opcional). Sem token, o transcript sai sem separar
# quem fala o quê.
HF_TOKEN=

CI_WHISPER_MODEL=small
CI_TRANSCRIBE=true
CI_OCR=true
CI_FACE_ANALYSIS=true
CI_MAX_KEYFRAMES=80
CI_SCENE_THRESHOLD=0.28

# ── Acesso ───────────────────────────────────────────────────────────────────
# Enquanto o módulo estiver em teste fechado, só estes e-mails veem a rota.
# Lista vazia = liberado para todo usuário autenticado.
CI_ALLOWED_EMAILS=martinhovff@gmail.com
